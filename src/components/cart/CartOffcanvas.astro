---
// CartOffcanvas.astro
---

<div id="cart-offcanvas" class="fixed inset-0 z-50 hidden" aria-labelledby="cart-title" role="dialog" aria-modal="true">
  {/* Overlay (fundo escuro) */}
  <div id="cart-overlay" class="fixed inset-0 bg-dark/60 backdrop-blur-sm transition-opacity opacity-0"></div>

  {/* Gaveta / Painel */}
  <div id="cart-drawer" class="fixed inset-y-0 right-0 z-10 w-full max-w-md bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
    
    {/* Cabecalho */}
    <div class="flex items-center justify-between px-6 py-4 border-b border-border">
      <h2 id="cart-title" class="type-display text-3xl uppercase">Sua Sacola</h2>
      <button id="cart-close" class="p-2 text-muted hover:text-dark transition-colors rounded-full hover:bg-surface-alt">
        <span class="sr-only">Fechar sacola</span>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    {/* Area de Itens */}
    <div class="flex-1 overflow-y-auto p-6" id="cart-items-container">
      {/* Populated by JS */}
    </div>

    {/* Estado Vazio (Escondido por padrao) */}
    <div id="cart-empty-state" class="hidden flex-1 flex-col items-center justify-center p-6 text-center">
      <div class="w-20 h-20 mb-6 bg-blush rounded-full flex items-center justify-center text-primary">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
      </div>
      <p class="text-dark-soft mb-6">Sua sacola está vazia.</p>
      <button id="cart-continue-empty" class="text-sm font-bold uppercase tracking-wider text-primary border-b-2 border-primary hover:text-primary-hover transition-colors">
        Continuar Comprando
      </button>
    </div>

    {/* Rodape / Totais */}
    <div id="cart-footer" class="border-t border-border p-6 bg-surface">
      <div class="flex justify-between text-lg font-bold text-dark mb-6">
        <span>Total</span>
        <span id="cart-total-price">R$ 0,00</span>
      </div>
      <a 
        id="checkout-whatsapp-btn" 
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 bg-primary hover:bg-primary-hover text-white py-4 px-6 font-bold tracking-widest uppercase text-sm transition-colors"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Finalizar Pedido
      </a>
      <p class="text-center text-xs text-muted mt-4">Redirecionamento para o WhatsApp da loja.</p>
    </div>
  </div>
</div>

<script>
  import { getCart, updateQuantity, removeItem, getTotal } from '../../store/cartStore.js';
  import { formatCurrency } from '../../utils/formatCurrency.js';
  import { generateWhatsAppLink } from '../../utils/whatsappLink.js';

  // Refs
  const offcanvas = document.getElementById('cart-offcanvas');
  const overlay = document.getElementById('cart-overlay');
  const drawer = document.getElementById('cart-drawer');
  const closeBtn = document.getElementById('cart-close');
  const continueBtn = document.getElementById('cart-continue-empty');
  const itemsContainer = document.getElementById('cart-items-container');
  const emptyState = document.getElementById('cart-empty-state');
  const footer = document.getElementById('cart-footer');
  const totalPriceEl = document.getElementById('cart-total-price');
  const checkoutBtn = document.getElementById('checkout-whatsapp-btn');
  const cartToggle = document.getElementById('cart-toggle'); // Definido no Header.astro

  // Open / Close logic
  function openCart() {
    if (!offcanvas) return;
    offcanvas.classList.remove('hidden');
    // Forca reflow pra animacao
    void offcanvas.offsetWidth;
    overlay?.classList.add('opacity-100');
    overlay?.classList.remove('opacity-0');
    drawer?.classList.remove('translate-x-full');
    drawer?.classList.add('translate-x-0');
    renderCart();
  }

  function closeCart() {
    overlay?.classList.remove('opacity-100');
    overlay?.classList.add('opacity-0');
    drawer?.classList.remove('translate-x-0');
    drawer?.classList.add('translate-x-full');
    
    // Aguarda animacao acabar pra esconder container
    setTimeout(() => {
      offcanvas?.classList.add('hidden');
    }, 300);
  }

  cartToggle?.addEventListener('click', openCart);
  closeBtn?.addEventListener('click', closeCart);
  overlay?.addEventListener('click', closeCart);
  continueBtn?.addEventListener('click', closeCart);

  // Render logic
  function renderCart() {
    const cart = getCart();
    
    if (!itemsContainer || !emptyState || !footer || !totalPriceEl || !checkoutBtn) return;

    if (cart.length === 0) {
      itemsContainer.classList.add('hidden');
      footer.classList.add('hidden');
      emptyState.classList.remove('hidden');
      emptyState.classList.add('flex');
    } else {
      emptyState.classList.add('hidden');
      emptyState.classList.remove('flex');
      itemsContainer.classList.remove('hidden');
      footer.classList.remove('hidden');
      
      const total = getTotal();
      totalPriceEl.textContent = formatCurrency(total);
      
      checkoutBtn.setAttribute('href', generateWhatsAppLink(cart, total));

      // Build HTML for items
      itemsContainer.innerHTML = cart.map(item => `
        <div class="flex gap-4 py-4 border-b border-border/50 last:border-0" data-id="${item.id}" data-tamanho="${item.tamanho}">
          <div class="w-20 h-28 shrink-0 overflow-hidden bg-surface-alt">
            <img src="${item.imagem}" alt="${item.nome}" class="w-full h-full object-cover" />
          </div>
          
          <div class="flex flex-col flex-1">
            <div class="flex justify-between items-start mb-1">
              <div>
                <h3 class="text-sm font-bold text-dark leading-tight">${item.nome}</h3>
                <span class="text-xs text-dark-soft block mt-0.5">Tam: ${item.tamanho}</span>
              </div>
              <button class="cart-remove-btn text-muted hover:text-primary p-1 -mr-1 transition-colors" aria-label="Remover">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
            </div>
            
            <div class="mt-auto flex items-center justify-between">
              <div class="flex items-center bg-surface-alt rounded-full">
                <button class="cart-minus-btn w-8 h-8 flex items-center justify-center text-dark hover:text-primary transition-colors">-</button>
                <span class="cart-qty-span w-6 h-8 flex items-center justify-center text-sm font-medium text-dark">${item.quantidade}</span>
                <button class="cart-plus-btn w-8 h-8 flex items-center justify-center text-dark hover:text-primary transition-colors">+</button>
              </div>
              <div class="text-sm font-bold text-primary">
                ${formatCurrency(item.preco * item.quantidade)}
              </div>
            </div>
          </div>
        </div>
      `).join('');

      attachItemEvents();
    }
  }

  // Event Delegation for items
  function attachItemEvents() {
    const itemEls = document.querySelectorAll('#cart-items-container > div');
    
    itemEls.forEach(el => {
      const id = el.getAttribute('data-id') as string;
      const tamanho = el.getAttribute('data-tamanho') as string;
      const qtEl = el.querySelector('.cart-qty-span'); // FIX: explicit class selector
      const currentQty = parseInt(qtEl?.textContent || '1', 10);

      const minusBtn = el.querySelector('.cart-minus-btn');
      const plusBtn = el.querySelector('.cart-plus-btn');
      const removeBtn = el.querySelector('.cart-remove-btn');

      minusBtn?.addEventListener('click', () => {
        updateQuantity(id, tamanho, currentQty - 1);
      });

      plusBtn?.addEventListener('click', () => {
        updateQuantity(id, tamanho, currentQty + 1);
      });

      removeBtn?.addEventListener('click', () => {
        removeItem(id, tamanho);
      });
    });
  }

  // Listen to global updates to re-render if drawer is open
  window.addEventListener('cart:updated', () => {
    // Only re-render if it's currently open to save resources
    if (!offcanvas?.classList.contains('hidden')) {
      renderCart();
    }
  });

</script>
