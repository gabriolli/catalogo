---
const currentYear = new Date().getFullYear();
const whatsappNumber = "5500000000000"; // Placeholder from config
---
<footer class="bg-dark text-white py-12 mt-auto border-t border-dark-soft/30">
  <div class="container mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-6 text-sm">
    <div class="flex flex-col items-center md:items-start gap-1">
      <span class="type-display text-2xl uppercase tracking-wider text-white">Maré</span>
      <p class="text-surface-alt/70">&copy; {currentYear} Todos os direitos reservados.</p>
    </div>
    <div class="flex gap-4">
      <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-surface-alt hover:text-primary transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
        <span class="font-medium uppercase tracking-wider text-xs">Fale conosco</span>
      </a>
    </div>
  </div>
</footer>
