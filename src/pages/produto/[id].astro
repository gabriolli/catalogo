---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import SizeSelector from '../../components/SizeSelector.astro';
import { formatCurrency } from '../../utils/formatCurrency.js';
import { SITE_NAME, MAX_INSTALLMENTS, CATEGORIES } from '../../config/site.js';

export async function getStaticPaths() {
  const produtos = await getCollection('produtos');
  return produtos.map(produto => ({
    params: { id: produto.id },
    props: { produto },
  }));
}

const { produto } = Astro.props;
const { nome, preco, descricao, referencia, tamanhos, imagens, categoria } = produto.data;
const categoriaInfo = CATEGORIES[categoria];
---

<BaseLayout title={`${nome} | ${SITE_NAME}`} description={descricao}>
  <div class="container mx-auto px-4 pt-6 pb-20 md:pt-8 md:pb-28">

    <nav class="text-sm text-muted mb-6 md:mb-8" aria-label="Breadcrumb">
      <ol class="flex flex-wrap gap-2">
        <li><a href="/" class="hover:text-dark hover:underline underline-offset-4">Início</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/#${categoriaInfo.id}`} class="hover:text-dark hover:underline underline-offset-4">{categoriaInfo.label}</a></li>
        <li aria-hidden="true">/</li>
        <li><span class="text-dark" aria-current="page">{nome}</span></li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <div class="lg:col-span-4 lg:col-start-2 lg:sticky lg:top-24">
        <ProductGallery imagens={imagens} nome={nome} />
      </div>

      <div class="lg:col-span-7 lg:col-start-7 lg:pt-2">
        <p class="text-sm text-muted">Ref. {referencia}</p>
        <h1 class="type-display text-[3.5rem] md:text-[4.5rem] text-dark mt-2">{nome}</h1>

        <div class="mt-5">
          <p class="text-[1.75rem] font-semibold text-primary leading-none">{formatCurrency(preco)}</p>
          <p class="text-[15px] text-muted mt-2">
            ou {MAX_INSTALLMENTS}x de {formatCurrency(preco / MAX_INSTALLMENTS)} sem juros no cartão
          </p>
        </div>

        <p class="mt-6 text-[15px] leading-relaxed text-dark-soft">{descricao}</p>

        <form id="add-to-cart-form" class="mt-8 pt-8 border-t border-border" novalidate>
          <input type="hidden" name="produtoId" value={produto.id} />
          <input type="hidden" name="nome" value={nome} />
          <input type="hidden" name="preco" value={preco} />
          <input type="hidden" name="imagem" value={imagens[0].src} />

          <SizeSelector tamanhos={tamanhos} />

          <button
            type="submit"
            class="mt-8 w-full bg-primary hover:bg-primary-hover active:scale-[0.99] text-white font-semibold text-[17px] py-4 px-8 rounded-full transition flex justify-center items-center gap-2.5"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            Adicionar à sacola
          </button>
        </form>

        <ul class="mt-8 space-y-3 text-[15px] text-dark-soft">
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
            Troca fácil se o tamanho não servir
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 shrink-0 text-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            Pagamento e entrega combinados no WhatsApp
          </li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('add-to-cart-form') as HTMLFormElement;
  const sizeError = document.getElementById('size-error');
  const sizesContainer = document.getElementById('sizes-container');
  const sizeRadios = document.querySelectorAll('.size-radio');

  if (form) {
    // Clear error style when user selects a size
    sizeRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        if (sizesContainer) {
          sizesContainer.classList.remove('ring-2', 'ring-danger', 'ring-offset-2', 'animate-shake');
        }
        if (sizeError) sizeError.classList.add('hidden');
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const tamanho = formData.get('tamanho');

      if (!tamanho) {
        if (sizeError) sizeError.classList.remove('hidden');
        if (sizesContainer) {
          // Re-trigger animacao clonando e substituindo classe
          sizesContainer.classList.remove('animate-shake');
          void sizesContainer.offsetWidth; // trigger reflow
          sizesContainer.classList.add('ring-2', 'ring-danger', 'ring-offset-2', 'animate-shake');
        }
        return;
      }

      const item = {
        id: formData.get('produtoId'),
        nome: formData.get('nome'),
        preco: Number(formData.get('preco')),
        imagem: formData.get('imagem'),
        tamanho: tamanho,
        quantidade: 1
      };

      // Dispara evento para o toast (implementado na F2) e para o futuro script de cart (F4)
      document.dispatchEvent(new CustomEvent('cart:item-added', { detail: item }));
      
      // Opcional: resetar selecao apos adicionar
      // form.reset();
    });
  }
</script>
